        "marginaleffects": {
          "source": "cran",
          "auto_attach": false
        },
        "emmeans": {
          "source": "cran",
          "auto_attach": false
        },
        "performance": {
          "source": "cran",
          "auto_attach": false
        },
        "broom": {
          "source": "cran",
          "auto_attach": false
        },
        "broom.mixed": {
          "source": "cran",
          "auto_attach": false
        }
      }
    }
  }
