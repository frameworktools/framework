{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://framework.pub/schema/layer/v1.json",
  "title": "Framework project spec layer",
  "description": "One unmerged layer of a project spec. Every field is optional, and a null map entry removes that key when spec_resolve() merges layers.",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "A label for the blueprint the project came from. Framework's own are project, project_sensitive, course, presentation, and bare. Behavior follows settings, tools, and core_files, not this label."
    },
    "core_files": {
      "type": "boolean",
      "description": "Whether the structure writes Framework's core files (starter scripts and .env). false for bare structures. Missing means true."
    },
    "settings_layout": {
      "type": "string",
      "enum": [
        "split",
        "flat"
      ],
      "description": "split: connections, packages, and data in settings/*.yml. flat: everything in settings.yml. Missing means split for Framework's project and project_sensitive structures and flat for the rest."
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Tool id -> on. Missing means off. Framework's tools are defined in inst/features/<id>.json. In a layer, later layers override earlier ones key by key.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "r",
        "python",
        "stata"
      ],
      "description": "Primary language. The R package builds r, the Python package builds python, and fw builds stata (scaffolding only). A layers file with no language means r."
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "affiliation": {
          "type": "string"
        },
        "orcid": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "department": {
                "type": "string"
              },
              "city": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "directories": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "extra_directories": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/extra_directory"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "render_dirs": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "packages": {
      "type": "object",
      "properties": {
        "use_renv": {
          "type": "boolean"
        },
        "default_packages": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/package"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Package name -> spec. JSON object key order is not kept (Postgres JSONB sorts keys).",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "git": {
      "type": "object",
      "properties": {
        "use_git": {
          "type": "boolean"
        },
        "hooks": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "gitignore_content": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ai": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "assistants": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "claude",
              "codex",
              "copilot"
            ]
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "description": "Assistant -> true to include. In a layer, false or null removes it."
        },
        "agents_md": {
          "type": "string",
          "enum": [
            "stub",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "scaffold": {
      "type": "object",
      "properties": {
        "seed_on_scaffold": {
          "type": "boolean"
        },
        "seed": {
          "type": "string"
        },
        "set_theme_on_scaffold": {
          "type": "boolean"
        },
        "ggplot_theme": {
          "type": "string"
        },
        "source_all_functions": {
          "type": "boolean"
        },
        "notebook_format": {
          "type": "string",
          "enum": [
            "quarto",
            "rmarkdown",
            "jupyter",
            "script"
          ]
        },
        "workflow": {
          "type": "string",
          "enum": [
            "quarto",
            "jupyter",
            "scripts"
          ],
          "description": "How notebooks are written. quarto allows notebook_format quarto (or rmarkdown in R), jupyter allows jupyter, and scripts allows script."
        },
        "ide": {
          "type": "string",
          "enum": [
            "vscode",
            "positron",
            "rstudio",
            "both",
            "none"
          ]
        }
      },
      "additionalProperties": false
    },
    "quarto": {
      "type": "object",
      "description": "Passed through to _quarto.yml generation"
    },
    "connections": {
      "type": "object",
      "properties": {
        "default_database": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "default_storage_bucket": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "databases": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/connection"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "storage_buckets": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/definitions/connection"
              },
              {
                "type": "null"
              }
            ]
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Variables written to .env. Secret-looking names must be empty.",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      }
    },
    "data_hooks": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[^:]+\\.(R|py)::[A-Za-z_.][A-Za-z0-9._]*$"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Directory key -> 'path/to/file.R::function'",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/file"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/definitions/skill"
          },
          {
            "type": "null"
          }
        ]
      },
      "propertyNames": {
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "cloud",
            "cli",
            "r",
            "python"
          ]
        },
        "fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "base",
                  "facet",
                  "blueprint"
                ]
              },
              "key": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "blueprint": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "study_plan": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "adopted": {
          "type": "boolean",
          "description": "True when adopt() made an existing folder a project, mapping its folders in place"
        },
        "framework_version": {
          "type": "string",
          "description": "Version of the R or Python package that created the project"
        },
        "fw_version": {
          "type": "string",
          "description": "Version of fw that created the project (Stata scaffolding)"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "package": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "cran",
            "github",
            "bioc",
            "pypi"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "auto_attach": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "auto_attach"
      ]
    },
    "extra_directory": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
        }
      },
      "additionalProperties": false,
      "required": [
        "path"
      ]
    },
    "file": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string"
        },
        "template": {
          "type": "boolean",
          "description": "Replace {{project_name}}, {{author}}, {{author_email}}, {{affiliation}}, and {{date}}"
        }
      },
      "additionalProperties": false,
      "required": [
        "content"
      ]
    },
    "skill": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "package": {
              "const": true
            }
          },
          "additionalProperties": false,
          "required": [
            "package"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "description": "Full SKILL.md text, including frontmatter"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "propertyNames": {
                "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[^\\\\]+$"
              }
            },
            "bundle": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  },
                  "executable": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "path",
                  "content",
                  "executable"
                ]
              },
              "maxItems": 256
            },
            "sync": {
              "type": "object",
              "properties": {
                "skill_id": {
                  "type": "string"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "variant": {
                  "type": "string",
                  "enum": [
                    "r",
                    "python",
                    "stata"
                  ]
                },
                "server": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "skill_id",
                "version",
                "hash",
                "variant",
                "server"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "content"
          ]
        }
      ]
    },
    "connection": {
      "type": "object",
      "properties": {
        "driver": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true,
      "required": [
        "driver"
      ]
    }
  }
}
