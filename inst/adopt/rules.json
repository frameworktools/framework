        "outputs/private/notebooks",
        "output/private/notebooks"
      ]
    },
    {
      "key": "outputs_public_notebooks",
      "patterns": [
        "outputs/public/notebooks",
        "output/public/notebooks"
      ]
    },
    {
      "key": "outputs_private_tables",
      "patterns": [
        "outputs/private/tables",
        "output/private/tables"
      ]
    },
    {
      "key": "outputs_public_tables",
      "patterns": [
        "outputs/public/tables",
        "output/public/tables"
      ]
    },
    {
      "key": "outputs_private_figures",
