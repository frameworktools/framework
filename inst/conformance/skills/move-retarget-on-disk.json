{
  "id": "move-retarget-on-disk",
  "area": "move",
  "description": "skills_move with a destination and a skill_id moves the folder, then switches the entry. The unedited copy's hash, read before the rename, becomes known.",
  "command": "move",
  "options": {
    "from": ".claude/skills/demo",
    "to": ".agents/skills/demo",
    "skill_id": "uuid-fork"
  },
  "project": {
    "variant": "r",
    "dirs": [
      ".agents/skills"
    ]
  },
  "folders": [
    ".claude/skills"
  ],
  "disk": {
    ".claude/skills/demo": "d1"
  },
  "lock": {
    "schema": 2,
    "skills": {
      "framework:demo@r": {
        "identity": {
          "kind": "builtin",
          "skill_id": "framework:demo",
          "variant": "r"
        },
        "base": {
          "channel": "package",
          "hash": "@d1",
          "version": null,
          "server": null
        },
        "known": [
          "@d1"
        ],
        "copies": {
          ".claude/skills/demo": {
            "hash": "@d1"
          }
        }
      }
    }
  },
  "expected": {
    "error": null,
    "steps": [
      {
        "path": ".agents/skills/demo",
        "entry": "framework:demo@r",
        "name": "demo",
        "action": "move",
        "status": "moved",
        "reason_code": "path_moved",
        "hint": null,
        "from": ".claude/skills/demo"
      },
      {
        "path": ".agents/skills/demo",
        "entry": "https://cloud.test/uuid-fork@r",
        "name": "demo",
        "action": "record",
        "status": "moved",
        "reason_code": "retargeted",
        "hint": null
      }
    ],
    "rows": [
      {
        "name": "demo",
        "status": "moved",
        "paths": [
          ".agents/skills/demo"
        ],
        "reason_code": "path_moved",
        "hint": null
      },
      {
        "name": "demo",
        "status": "moved",
        "paths": [
          ".agents/skills/demo"
        ],
        "reason_code": "retargeted",
        "hint": null
      }
    ],
    "disk": {
      ".agents/skills/demo": "d1"
    },
    "backups": [],
    "lock": {
      "schema": 2,
      "skills": {
        "https://cloud.test/uuid-fork@r": {
          "identity": {
            "kind": "cloud",
            "skill_id": "uuid-fork",
            "variant": "r",
            "server": "https://cloud.test"
          },
          "base": null,
          "known": [
            "@d1"
          ],
          "copies": {
            ".agents/skills/demo": {
              "hash": "@d1"
            }
          }
        }
      }
    }
  }
}
