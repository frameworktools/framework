{
  "id": "push-cloud-has-bytes",
  "area": "push",
  "description": "Cloud's head already holds the edited bytes (pushed from another checkout): nothing is sent, and the lock records Cloud's version.",
  "command": "push",
  "options": {
    "confirm": true
  },
  "project": {
    "variant": "r",
    "dirs": [
      ".claude/skills"
    ]
  },
  "folders": [],
  "disk": {
    ".claude/skills/mine": "e1"
  },
  "lock": {
    "schema": 2,
    "skills": {
      "https://cloud.test/uuid-mine@r": {
        "identity": {
          "kind": "cloud",
          "skill_id": "uuid-mine",
          "variant": "r",
          "server": "https://cloud.test"
        },
        "base": {
          "channel": "cloud",
          "hash": "@m2",
          "version": 2,
          "server": "https://cloud.test"
        },
        "known": [
          "@m2"
        ],
        "copies": {
          ".claude/skills/mine": {
            "hash": "@m2"
          }
        }
      }
    }
  },
  "offer": {
    "source": "cloud",
    "remote": {
      "https://cloud.test/uuid-mine@r": {
        "version": 3,
        "hash": "@e1"
      }
    }
  },
  "expected": {
    "error": null,
    "steps": [
      {
        "path": ".claude/skills/mine",
        "entry": "https://cloud.test/uuid-mine@r",
        "name": "mine",
        "action": "record",
        "status": "current",
        "reason_code": null,
        "hint": null
      }
    ],
    "rows": [
      {
        "name": "mine",
        "status": "current",
        "paths": [
          ".claude/skills/mine"
        ],
        "reason_code": null,
        "hint": null
      }
    ],
    "disk": {
      ".claude/skills/mine": "e1"
    },
    "backups": [],
    "lock": {
      "schema": 2,
      "skills": {
        "https://cloud.test/uuid-mine@r": {
          "identity": {
            "kind": "cloud",
            "skill_id": "uuid-mine",
            "variant": "r",
            "server": "https://cloud.test"
          },
          "base": {
            "channel": "cloud",
            "hash": "@e1",
            "version": 3,
            "server": "https://cloud.test"
          },
          "known": [
            "@e1",
            "@m2"
          ],
          "copies": {
            ".claude/skills/mine": {
              "hash": "@e1"
            }
          }
        }
      }
    }
  }
}
