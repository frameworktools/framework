{
  "id": "push-moved-by-hand-parent-exists",
  "area": "rename",
  "description": "Twin rule for push: the old folder still exists with other skills; the moved copy and the tracked entry both get the skills_move hint.",
  "command": "push",
  "options": {
    "confirm": true
  },
  "project": {
    "variant": "r",
    "dirs": [
      ".claude/skills",
      ".agents/skills"
    ]
  },
  "folders": [],
  "disk": {
    ".agents/skills/mine": "m1",
    ".claude/skills/other": "s1"
  },
  "lock": {
    "schema": 2,
    "skills": {
      "https://cloud.test/uuid-mine@r": {
        "identity": {
          "kind": "cloud",
          "skill_id": "uuid-mine",
          "variant": "r",
          "server": "https://cloud.test"
        },
        "base": {
          "channel": "cloud",
          "hash": "@m1",
          "version": 1,
          "server": "https://cloud.test"
        },
        "known": [
          "@m1"
        ],
        "copies": {
          ".claude/skills/mine": {
            "hash": "@m1"
          }
        }
      }
    }
  },
  "offer": {
    "source": "cloud",
    "remote": {
      "https://cloud.test/uuid-mine@r": {
        "version": 1,
        "hash": "@m1"
      }
    }
  },
  "expected": {
    "error": null,
    "steps": [
      {
        "path": ".agents/skills/mine",
        "entry": null,
        "name": "mine",
        "action": "none",
        "status": "untracked",
        "reason_code": "untracked",
        "hint": {
          "key": "move",
          "from": ".claude/skills/mine",
          "to": ".agents/skills/mine"
        }
      },
      {
        "path": ".claude/skills/mine",
        "entry": "https://cloud.test/uuid-mine@r",
        "name": "mine",
        "action": "none",
        "status": "missing",
        "reason_code": "folder_gone",
        "hint": {
          "key": "move",
          "from": ".claude/skills/mine",
          "to": ".agents/skills/mine"
        }
      },
      {
        "path": ".claude/skills/other",
        "entry": null,
        "name": "other",
        "action": "none",
        "status": "untracked",
        "reason_code": "untracked",
        "hint": {
          "key": "sync",
          "path": ".claude/skills/other"
        }
      }
    ],
    "rows": [
      {
        "name": "mine",
        "status": "untracked",
        "paths": [
          ".agents/skills/mine"
        ],
        "reason_code": "untracked",
        "hint": {
          "key": "move",
          "from": ".claude/skills/mine",
          "to": ".agents/skills/mine"
        }
      },
      {
        "name": "mine",
        "status": "missing",
        "paths": [
          ".claude/skills/mine"
        ],
        "reason_code": "folder_gone",
        "hint": {
          "key": "move",
          "from": ".claude/skills/mine",
          "to": ".agents/skills/mine"
        }
      },
      {
        "name": "other",
        "status": "untracked",
        "paths": [
          ".claude/skills/other"
        ],
        "reason_code": "untracked",
        "hint": {
          "key": "sync",
          "path": ".claude/skills/other"
        }
      }
    ],
    "disk": {
      ".agents/skills/mine": "m1",
      ".claude/skills/other": "s1"
    },
    "backups": [],
    "lock": "unchanged"
  }
}
