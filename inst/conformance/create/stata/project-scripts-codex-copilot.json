{
  "description": "Standard structure with Codex and Copilot instead of Claude Code.",
  "language": "stata",
  "layers": [
    {
      "kind": "base",
      "key": "project",
      "layer": {
        "type": "project"
      }
    },
    {
      "kind": "facet",
      "key": "framework/workflow-scripts",
      "layer": {
        "scaffold": {
          "notebook_format": "script",
          "workflow": "scripts"
        },
        "tools": {
          "jupyter": false,
          "quarto": false
        }
      }
    },
    {
      "kind": "project",
      "key": "choices",
      "layer": {
        "ai": {
          "assistants": {
            "claude": false,
            "codex": true,
            "copilot": true
          }
        },
        "git": {
          "use_git": false
        },
        "language": "stata"
      }
    }
  ],
  "spec": {
    "ai": {
      "agents_md": "stub",
      "assistants": {
        "codex": true,
        "copilot": true
      },
      "enabled": true
    },
    "author": {
      "affiliation": "",
      "email": "ada@example.org",
      "name": "Ada Analyst"
    },
    "data_hooks": {},
    "directories": {
      "do": "do",
      "docs": "docs",
      "inputs_final": "inputs/final",
      "inputs_intermediate": "inputs/intermediate",
      "inputs_raw": "inputs/raw",
      "logs": "logs",
      "outputs_figures": "outputs/figures",
      "outputs_tables": "outputs/tables",
      "scratch": "scratch"
    },
    "env": {},
    "extra_directories": {},
    "files": {},
    "git": {
      "gitignore_content": "# Framework Stata project\n# Data files stay out of git. Do-files, settings.do, and documentation are\n# committed; data and logs are not.\n\n# Stata data and session files\n*.dta\n*.log\n*.smcl\n*.stswp\n\n# Private data, anywhere in the project\n**/private/**\n**/*_private/**\n\n# Secrets and credentials\n.env\n.env.*\n!.env.example\n**/credentials/**\n**/secrets/**\n*.key\n*.pem\n\n# Logs, cache, and scratch work\n**/logs/**\n**/cache/**\n**/scratch/**\n**/tmp/**\nslurm-*.out\n\n# System files\n.DS_Store\nThumbs.db\n*~\n*.tmp\n*.bak\n",
      "hooks": {},
      "use_git": false
    },
    "language": "stata",
    "name": "Fixture Study",
    "scaffold": {
      "notebook_format": "script",
      "seed": "",
      "seed_on_scaffold": false,
      "workflow": "scripts"
    },
    "security": {
      "sensitive": false
    },
    "skills": {
      "framework-stata": {
        "package": true
      }
    },
    "spec_version": 1,
    "tools": {
      "jupyter": false,
      "quarto": false
    },
    "type": "project"
  },
  "expected": {
    "paths": [
      ".agents/",
      ".agents/skills/",
      ".agents/skills/framework-stata/",
      ".agents/skills/framework-stata/SKILL.md",
      ".framework/",
      ".framework/spec.json",
      ".github/",
      ".github/copilot-instructions.md",
      ".gitignore",
      "AGENTS.md",
      "do/",
      "do/.gitkeep",
      "docs/",
      "docs/.gitkeep",
      "inputs/",
      "inputs/final/",
      "inputs/final/.gitkeep",
      "inputs/intermediate/",
      "inputs/intermediate/.gitkeep",
      "inputs/raw/",
      "inputs/raw/.gitkeep",
      "logs/",
      "logs/.gitkeep",
      "master.do",
      "outputs/",
      "outputs/figures/",
      "outputs/figures/.gitkeep",
      "outputs/tables/",
      "outputs/tables/.gitkeep",
      "scratch/",
      "scratch/.gitkeep",
      "settings.do"
    ]
  }
}
