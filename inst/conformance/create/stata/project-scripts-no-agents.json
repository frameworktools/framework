{
  "description": "Standard structure with AI agents off.",
  "language": "stata",
  "layers": [
    {
      "kind": "base",
      "key": "project",
      "layer": {
        "type": "project"
      }
    },
    {
      "kind": "facet",
      "key": "framework/workflow-scripts",
      "layer": {
        "scaffold": {
          "notebook_format": "script",
          "workflow": "scripts"
        },
        "tools": {
          "jupyter": false,
          "quarto": false
        }
      }
    },
    {
      "kind": "project",
      "key": "choices",
      "layer": {
        "ai": {
          "enabled": false
        },
        "git": {
          "use_git": false
        },
        "language": "stata"
      }
    }
  ],
  "spec": {
    "ai": {
      "agents_md": "stub",
      "assistants": {
        "claude": true
      },
      "enabled": false
    },
    "author": {
      "affiliation": "",
      "email": "ada@example.org",
      "name": "Ada Analyst"
    },
    "data_hooks": {},
    "directories": {
      "do": "do",
      "docs": "docs",
      "inputs_final": "inputs/final",
      "inputs_intermediate": "inputs/intermediate",
      "inputs_raw": "inputs/raw",
      "logs": "logs",
      "outputs_figures": "outputs/figures",
      "outputs_tables": "outputs/tables",
      "scratch": "scratch"
    },
    "env": {},
    "extra_directories": {},
    "files": {},
    "git": {
      "gitignore_content": "# Framework Stata project\n# As in R and Python projects, git ignores data by folder, not by file type:\n# everything under a private/ folder stays out of git, and so do logs, cache,\n# scratch, and tmp folders. Data in other folders, such as a public .dta,\n# can be committed. Put data that must stay on this machine under private/.\n#\n# In this project, data in inputs/ and outputs/ is committable, as in R and\n# Python projects. To keep it out of git, add its folder below (for example\n# /inputs/raw/), or add *.dta to ignore every Stata dataset.\n\n# Stata logs and session files\n*.log\n*.smcl\n*.stswp\n\n# Private data, anywhere in the project\n**/private/**\n**/*_private/**\n\n# Secrets and credentials\n.env\n.env.*\n!.env.example\n**/credentials/**\n**/secrets/**\n*.key\n*.pem\n\n# Logs, cache, and scratch work\n**/logs/**\n**/cache/**\n**/scratch/**\n**/tmp/**\nslurm-*.out\n\n# System files\n.DS_Store\nThumbs.db\n*~\n*.tmp\n*.bak\n",
      "hooks": {},
      "use_git": false
    },
    "language": "stata",
    "name": "Fixture Study",
    "scaffold": {
      "notebook_format": "script",
      "seed": "",
      "seed_on_scaffold": false,
      "workflow": "scripts"
    },
    "security": {
      "sensitive": false
    },
    "skills": {
      "framework-stata": {
        "package": true
      }
    },
    "spec_version": 1,
    "tools": {
      "jupyter": false,
      "quarto": false
    },
    "type": "project"
  },
  "expected": {
    "paths": [
      ".framework/",
      ".framework/spec.json",
      ".gitignore",
      "do/",
      "do/.gitkeep",
      "docs/",
      "docs/.gitkeep",
      "inputs/",
      "inputs/final/",
      "inputs/final/.gitkeep",
      "inputs/intermediate/",
      "inputs/intermediate/.gitkeep",
      "inputs/raw/",
      "inputs/raw/.gitkeep",
      "logs/",
      "logs/.gitkeep",
      "master.do",
      "outputs/",
      "outputs/figures/",
      "outputs/figures/.gitkeep",
      "outputs/tables/",
      "outputs/tables/.gitkeep",
      "scratch/",
      "scratch/.gitkeep",
      "settings.do",
      "settings.yml"
    ]
  }
}
