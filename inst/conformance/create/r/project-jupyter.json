          "workflow": "jupyter",
          "notebook_format": "jupyter"
        }
      }
    },
    {
      "kind": "project",
      "key": "choices",
      "layer": {
        "git": {
          "use_git": false
        },
        "scaffold": {
          "ide": "vscode"
        }
      }
    }
  ],
  "spec": {
    "spec_version": 1,
    "name": "Fixture Study",
    "type": "project",
    "language": "r",
    "core_files": true,
    "settings_layout": "split",
    "tools": {
      "quarto": true,
      "renv": false,
      "jupyter": true
    },
    "author": {
      "name": "Ada Analyst",
      "email": "ada@example.org",
      "affiliation": ""
    },
    "directories": {
