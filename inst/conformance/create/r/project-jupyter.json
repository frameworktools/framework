{
  "description": "Standard structure, Jupyter workflow: Jupyter and Quarto on.",
  "language": "r",
  "layers": [
    {
      "kind": "base",
      "key": "project",
      "layer": {
        "type": "project"
      }
    },
    {
      "kind": "facet",
      "key": "framework/tool-jupyter",
      "layer": {
        "tools": {
          "jupyter": true
        }
      }
    },
    {
      "kind": "facet",
      "key": "framework/tool-jupyter-r",
      "layer": {
        "packages": {
          "default_packages": {
            "IRkernel": {
              "source": "cran",
              "auto_attach": false
            }
          }
        }
      }
    },
    {
      "kind": "facet",
      "key": "framework/tool-quarto",
      "layer": {
        "tools": {
          "quarto": true
        }
      }
    },
    {
      "kind": "facet",
      "key": "framework/workflow-jupyter",
      "layer": {
