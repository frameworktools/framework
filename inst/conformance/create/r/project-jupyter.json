      "outputs_tables": "outputs/tables",
      "outputs_figures": "outputs/figures",
      "outputs_models": "outputs/models",
      "outputs_reports": "outputs/reports",
      "cache": "outputs/cache",
      "scratch": "scratch",
      "logs": "logs"
    },
    "extra_directories": {},
    "render_dirs": {
      "notebooks": "outputs/notebooks",
      "docs": "outputs/docs"
    },
    "packages": {
      "use_renv": false,
      "default_packages": {
        "dplyr": {
          "source": "cran",
          "auto_attach": true
        },
        "ggplot2": {
          "source": "cran",
          "auto_attach": true
        },
        "tidyr": {
          "source": "cran",
          "auto_attach": true
        },
        "stringr": {
          "source": "cran",
          "auto_attach": true
        },
        "readr": {
          "source": "cran",
          "auto_attach": true
        },
        "purrr": {
          "source": "cran",
          "auto_attach": false
        },
        "tibble": {
          "source": "cran",
          "auto_attach": true
        },
        "forcats": {
          "source": "cran",
          "auto_attach": true
        },
        "lubridate": {
          "source": "cran",
          "auto_attach": false
        },
        "glue": {
          "source": "cran",
          "auto_attach": false
        },
        "here": {
          "source": "cran",
